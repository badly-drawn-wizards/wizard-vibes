#slide[Music from a function of time][
  #let m = json("data/music.json")
  #grid(columns: (1.35fr, 1fr), gutter: 0.8cm,
    align(center, canvas(16, 9.4, {
      // one second: each column the lowest and highest sample in it
      let env = m.envelope
      let n = env.len()
      let (y0, hh) = (2.0, 1.7)
      for (i, (lo, hi)) in env.enumerate() { seg((i / n * 16, y0 - hi * hh * 2), (i / n * 16, y0 - lo * hh * 2), col: glow.transparentize(20%), w: 1pt) }
      label((0, 3.9), [one second of the music (left channel)], col: dim, size: 12pt)
      // 12 ms, sample by sample
      let z = m.zoom
      poly(z.enumerate().map(((i, v)) => (i / z.len() * 16, 6.2 - v * 3)), col: accent, w: 1.4pt)
      label((0, 7.9), [12 ms of it: #z.len() samples, each computed from its time alone], col: dim, size: 12pt)
    })),
    [
      Sound is a list of numbers (#term[samples]), 48 000 a second per ear.

      #v(0.3em)
      As in #term[Shadertoy], each sample is a pure function of time: `music t = (left, right)`. Notes, chords, echoes and drums are all formulas in $t$.
      ```
      def sound t0 rate n =  -- a chunk
        tabulate n (\i ->
          music (t0 + i / rate))
      ```
      The page asks the GPU for ≈ 85 ms of samples at a time, keeping ≈ ⅓ s queued ahead of the speakers.
      #note[Time stays in double precision on the page: in 32-bit floats it stops resolving single samples after a few minutes.]
    ])
]

