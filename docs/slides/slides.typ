#slide[Shader size is a hidden cost][
  #grid(columns: (1fr, 1fr), gutter: 1.2cm,
    [
      #bars((("everything inlined", 2230), ("projected + noinline", 1622)), max: 2400, width: 7.5, unit: "KiB")
      #v(0.4em)
      Chrome compiles each GPU *pipeline* at load, slowly, on one thread. A huge shader meant seconds of black screen.
      #v(0.3em)
      `#[noinline]` keeps a function as a real GPU function, but it receives every record field as a parameter: passing the whole *pose* means ≈ 200 arguments.
    ],
    [
      ```
      -- what the sky needs, out of ~200
      type sky_in = { horizon, zenith, moon,
                      moon_size, ..., secs }

      #[noinline]
      def sky_colour (sk: sky_in) rd = ...

      -- callers are unchanged
      def sky pose rd =
        sky_colour (sky_in_of pose) rd
      ```
      #note[Plus: fewer kernels holding the shading, and pipelines created asynchronously. Time to first frame roughly halved.]
    ])
]

