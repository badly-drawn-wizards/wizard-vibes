#slide[Glass and glow][
  #grid(columns: (1fr, 1.4fr), gutter: 0.8cm,
    [
      #align(center, canvas(12, 8, {
        // refraction through a glass ball (index 1.5), by Snell's law
        let c = (6.5, 4.0)
        let r = 2.4
        solid(c, r, col: glow)
        let o = (0.3, 2.6)
        let d = (1.0, 0.0)
        let oc = vsub(o, c)
        let b = vdot(oc, d)
        let t = -b - calc.sqrt(b * b - (vdot(oc, oc) - r * r))
        let p = vadd(o, vmul(d, t))
        let refract(d, n, eta) = {
          let cosi = -vdot(d, n)
          let k = 1 - eta * eta * (1 - cosi * cosi)
          vadd(vmul(d, eta), vmul(n, eta * cosi - calc.sqrt(k)))
        }
        let n = vnorm(vsub(p, c))
        let inside = refract(d, n, 1 / 1.5)
        let s = -2 * vdot(vsub(p, c), inside)
        let q = vadd(p, vmul(inside, s))
        let n2 = vmul(vnorm(vsub(q, c)), -1)
        let out = refract(inside, n2, 1.5)
        let refl = vsub(d, vmul(n, 2 * vdot(d, n)))
        seg(vsub(p, vmul(n, 1.4)), vadd(p, vmul(n, 1.4)), col: dim, w: 0.8pt, dash: "dashed")
        arrow(o, p, col: fg, w: 1.6pt)
        arrow(p, q, col: fg, w: 1.6pt)
        arrow(q, vadd(q, vmul(out, 4)), col: fg, w: 1.6pt)
        arrow(p, vadd(p, vmul(refl, 2.2)), col: warm.transparentize(20%), w: 1.2pt)
        label(vadd(p, (-2.6, -1.6)), [some reflects], col: warm, size: 12pt)
        label((0.2, 7.4), [the rest bends in, and out again], col: fg, size: 12pt)
      }))
    ],
    [
      The orb is a glass ball, solved exactly (where a ray meets a sphere is a quadratic equation). At the glass the ray #term[refracts] (bends, by Snell's law) and partly reflects; the reflected share grows at grazing angles (#term[Fresnel]).

      #v(0.3em)
      #grid(columns: (1fr, 1fr, 1fr), gutter: 0.4cm,
        fig("orb-lightning.png", [lightning], width: 100%),
        fig("orb-fire.png", [fire], width: 100%),
        fig("orb-wind.png", [wind], width: 100%))
      #note[Glows are added along the march: near the orb, each step adds a little light, more the closer it passes.]
    ])
]

#section[The world][Endless land, and keeping the marching fast]

#slide[Terrain: a height map is not a distance][
  #grid(columns: (1fr, 1fr), gutter: 0.6cm,
    fig("terrain.png", [the land: fbm heights, ridges, rivers carved in, a sea], width: 100%),
    fig("terrain-normals.png", [its normals, from the noise's exact slope (differentiated with it)], width: 100%))
  #v(0.2em)
  #grid(columns: (1fr, 1.1fr), gutter: 1cm,
    align(center, canvas(13, 4.4, {
      let h(x) = 2.6 + 1.3 * calc.sin((x - 4.0) * 0.55) + 0.25 * calc.sin(x * 2.3)
      poly(range(0, 131).map(i => (i / 10, h(i / 10))), col: accent, w: 2pt)
      let p = (6.6, 0.7)
      let gap = h(p.at(0)) - p.at(1)
      // the true distance to the ground, by searching the curve
      let true-d = range(0, 1301).map(i => { let x = i / 100; vlen(vsub((x, h(x)), p)) }).fold(100.0, calc.min)
      ring(p, gap, col: bad, w: 1.3pt)
      ring(p, 0.6 * gap, col: good, w: 1.6pt)
      seg(p, (p.at(0), h(p.at(0))), col: fg, w: 1pt, dash: "dashed")
      dot(p, col: fg)
      label((0.2, 0.1), [height gap: too far], col: bad, size: 12pt)
      label((0.2, 0.6), [0.6 × gap: safe], col: good, size: 12pt)
      assert(0.6 * gap <= true-d, message: "the 0.6 bound must be safe here")
    })),
    [The height above the ground (dashed) is *more* than the distance to a slope: stepping that far could jump into a hillside (red). Because the slopes are never steeper than about 53°, 0.6 of it is always safe (green).])
]

#slide[Endless buildings from a grid][
  #grid(columns: (1fr, 1.1fr), gutter: 1cm,
    [
      #align(center, canvas(12, 9, {
        // cells of 3; each building's centre kept a quarter cell (0.75) in
        // from its cell's edges; each fits within `reach` of its centre
        let (cell, margin, reach) = (3.0, 0.75, 0.45)
        for i in range(0, 5) { seg((i * cell, 0), (i * cell, 9), col: dim, w: 0.8pt) }
        for j in range(0, 4) { seg((0, j * cell), (12, j * cell), col: dim, w: 0.8pt) }
        let buildings = ((0, 0, 0.2, 0.8), (1, 2, 0.9, 0.1), (2, 0, 0.6, 1.0), (3, 1, 0.0, 0.4), (3, 2, 1.0, 0.7), (0, 1, 1.0, 0.0))
        for (cx, cy, fx, fy) in buildings {
          let c = (cx * cell + margin + fx * (cell - 2 * margin), cy * cell + margin + fy * (cell - 2 * margin))
          ring(c, reach, col: accent.transparentize(30%), w: 0.8pt, dash: "dotted")
          at(c.at(0) - 0.3, c.at(1) - 0.3, rect(width: 0.6cm, height: 0.6cm, fill: accent.transparentize(30%), stroke: 1.2pt + accent))
        }
        // a point in an empty cell: the nearest building in any other cell
        // is at least (distance to this cell's border) + margin - reach away
        let p = (5.2, 4.1)
        let (ix, iy) = (calc.floor(p.at(0) / cell), calc.floor(p.at(1) / cell))
        let border = calc.min(p.at(0) - ix * cell, (ix + 1) * cell - p.at(0), p.at(1) - iy * cell, (iy + 1) * cell - p.at(1))
        let bound = border + margin - reach
        ring(p, bound, col: glow, w: 1.6pt)
        dot(p)
        label(vadd(p, (-0.6, 0.35)), [$p$], col: glow)
      }))
      #cap[Each cell's hash decides: a building or not, which kind, where (kept a margin in from the edges) and how turned.]
    ],
    [
      Checking every building would be impossible: there are infinitely many. Instead, the distance function returns a *lower bound*: a step that cannot reach any building.

      #v(0.3em)
      A building in another cell is at least as far as this cell's border, plus the margin, less its own size. That is the blue circle: the ray at $p$ may step that far.

      #v(0.3em)
      #note[Every shortcut in the renderer works like this: it may underestimate the distance (costing an extra step) but must never overestimate it (that would step through a wall).]
    ])
]

#slide[Two marches per ray][
  #grid(columns: (1.3fr, 1fr), gutter: 1cm,
    align(center, canvas(15, 8.5, {
      let c = (4.5, 4.0)
      let rr = 2.6
      ring(c, rr, col: glow.transparentize(30%), w: 1.5pt, fill: glow.transparentize(90%))
      label((2.4, 0.9), [the wizard's sphere], col: glow, size: 13pt)
      at(3.95, 3.1, rect(width: 1.1cm, height: 2.2cm, radius: 4pt, fill: rgb("#8a3fc0")))
      let h(x) = 7.3 + 0.4 * calc.sin(x * 0.8) + 0.2 * calc.sin(x * 2.1)
