        node(3.5, 0.2, 7, 1.4, [the Futhark program], col: accent)
        arrow((7, 1.6), (3.5, 3.0)); arrow((7, 1.6), (10.5, 3.0))
        node(0.2, 3.0, 6.6, 2.0, text(size: 13pt)[compiled for the browser:\ GPU code + WebAssembly])
        node(7.2, 3.0, 6.6, 2.0, text(size: 13pt)[compiled for the CPU:\ an ordinary program], col: dim)
        arrow((3.5, 5.0), (3.5, 6.4))
        arrow((10.5, 5.0), (10.5, 6.4), col: dim)
        node(0.2, 6.4, 6.6, 2.0, text(size: 13pt)[the web page,\ 60 fps])
        node(7.2, 6.4, 6.6, 2.0, text(size: 13pt)[exact test images\ (and these slides' pictures)], col: dim)
      }))
      #cap[One source, two targets: every refactoring is checked to change no pixel.]
