      let (t0, t1) = (-b - disc, -b + disc)
      let tl = range(0, 2000).map(i => i / 100).find(t => { let q = vadd(o, vmul(d, t)); q.at(1) >= h(q.at(0)) })
      seg(o, vadd(o, vmul(d, tl)), col: accent.transparentize(30%), w: 2.5pt)
