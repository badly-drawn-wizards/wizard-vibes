// Techniques behind the Futhark wizard: a slideshow for programmers who have
// not done computer graphics. Build: typst compile docs/slides/slides.typ
// (no packages needed).
//
// Images in img/ and data in data/ are regenerated by
// `nix develop -c node docs/slides/capture.ts`. The diagrams compute their
// own geometry here, with the same algorithms as the renderer (sphere
// tracing, the over-relaxed march, the soft-shadow estimate, ...), so what
// they show is what those algorithms do.

#let bg = rgb("#0b0a1c")
#let fg = rgb("#e4e0ff")
#let dim = rgb("#9a96c8")
#let accent = rgb("#c9a227")
#let glow = rgb("#7fd3ff")
#let warm = rgb("#f29e52")
#let bad = rgb("#ff6b7a")
#let good = rgb("#7be0a0")
#let panel = rgb("#16142e")

#set page(width: 32cm, height: 18cm, margin: (x: 1.4cm, y: 1.1cm), fill: bg)
#set text(font: ("DejaVu Sans", "Liberation Sans"), size: 17pt, fill: fg)
#set par(leading: 0.55em)
#show raw: set text(font: ("DejaVu Sans Mono", "Liberation Mono"), size: 13pt)
#show raw.where(block: true): it => block(fill: panel, inset: 11pt, radius: 6pt, width: 100%, it)
#show heading.where(level: 1): it => block(below: 0.6em, text(size: 28pt, fill: accent, weight: "bold", it.body))
#show strong: set text(fill: glow)
#set list(marker: text(fill: accent)[•], spacing: 0.7em)

#let slide(title, body) = {
  pagebreak(weak: true)
  heading(level: 1, title)
  body
}
#let section(title, sub) = page(fill: bg)[
  #align(center + horizon)[
    #text(size: 40pt, weight: "bold", fill: accent, title)
    #v(0.2em)
    #text(size: 20pt, fill: dim, sub)
  ]
]
#let note(body) = text(size: 14pt, fill: dim, body)
#let cap(body) = align(center, text(size: 14pt, fill: dim, body))
#let img(path, ..args) = image("img/" + path, ..args)
#let fig(path, caption, ..args) = stack(spacing: 6pt, img(path, ..args), cap(caption))
#let term(word) = text(fill: glow, weight: "bold", word)

// ---------------------------------------------------------------------
// Vector maths and the algorithms the diagrams run (2D, units of cm, y down)

#let vadd(a, b) = (a.at(0) + b.at(0), a.at(1) + b.at(1))
#let vsub(a, b) = (a.at(0) - b.at(0), a.at(1) - b.at(1))
#let vmul(a, k) = (a.at(0) * k, a.at(1) * k)
#let vdot(a, b) = a.at(0) * b.at(0) + a.at(1) * b.at(1)
#let vlen(a) = calc.sqrt(vdot(a, a))
#let vnorm(a) = vmul(a, 1 / vlen(a))
#let circle-sd(c, r) = p => vlen(vsub(p, c)) - r

// Sphere tracing from o along unit d: the points visited, each with its
// distance and whether it was a step taken back (over-relaxation, as in
// march_terrain: a step of relax * d, undone when the next point's bound
// shows it went too far).
#let trace(f, o, d, relax: 1.0, eps: 0.03, max: 60) = {
  let pts = ()
  let (t, prev, step, omega) = (0.0, 0.0, 0.0, relax)
  for i in range(max) {
    let p = vadd(o, vmul(d, t))
    let dist = f(p)
    if omega > 1 and dist + prev < step {
      pts.push((p: p, d: dist, back: true))
      t = t - step + prev
      (omega, prev, step) = (1.0, 0.0, 0.0)
    } else {
      pts.push((p: p, d: dist, back: false))
      if dist < eps { break }
      prev = dist
      step = omega * dist
      t += step
    }
  }
  pts
}

// --- drawing (coordinates in cm, y down) ---
#let at(x, y, body) = place(dx: x * 1cm, dy: y * 1cm, body)
#let seg(a, b, col: fg, w: 1.5pt, dash: none) = place(line(start: (a.at(0) * 1cm, a.at(1) * 1cm), end: (b.at(0) * 1cm, b.at(1) * 1cm), stroke: (paint: col, thickness: w, dash: dash)))
#let poly(pts, col: fg, w: 1.5pt) = for i in range(pts.len() - 1) { seg(pts.at(i), pts.at(i + 1), col: col, w: w) }
#let arrow(a, b, col: fg, w: 1.5pt, dash: none) = {
  let u = vnorm(vsub(b, a))
  let s = 0.28
  let back = vsub(b, vmul(u, s))
  seg(a, back, col: col, w: w, dash: dash)
  place(polygon(fill: col, stroke: none,
    (b.at(0) * 1cm, b.at(1) * 1cm),
    ((back.at(0) - u.at(1) * s * 0.5) * 1cm, (back.at(1) + u.at(0) * s * 0.5) * 1cm),
    ((back.at(0) + u.at(1) * s * 0.5) * 1cm, (back.at(1) - u.at(0) * s * 0.5) * 1cm)))
}
#let dot(p, col: glow, r: 3.5pt) = place(dx: p.at(0) * 1cm - r, dy: p.at(1) * 1cm - r, circle(radius: r, fill: col))
#let ring(c, r, col: glow, w: 1.2pt, fill: none, dash: none) = place(dx: (c.at(0) - r) * 1cm, dy: (c.at(1) - r) * 1cm, circle(radius: r * 1cm, stroke: (paint: col, thickness: w, dash: dash), fill: fill))
#let label(p, body, col: fg, size: 14pt) = at(p.at(0), p.at(1), text(fill: col, size: size, body))
#let node(x, y, w, h, body, col: glow) = at(x, y, rect(width: w * 1cm, height: h * 1cm, radius: 5pt, fill: panel, stroke: 1.2pt + col, align(center + horizon, text(size: 14pt, body))))
#let canvas(w, h, body) = box(width: w * 1cm, height: h * 1cm, clip: true, body)
#let solid(c, r, col: accent) = ring(c, r, col: col, w: 2pt, fill: col.transparentize(72%))

// A horizontal bar chart: rows of (label, value), scaled to `max`. The value
// goes inside a bar wide enough for it, otherwise after it, in white.
#let bars(rows, max: 12, width: 12, col: glow, unit: "ms") = grid(columns: (auto, width * 1cm), gutter: 8pt, align: (right + horizon, left + horizon),
  ..rows.map(((l, v)) => {
    let w = v / max * width * 1cm
    let value = str(v) + " " + unit
    (text(size: 14pt, l), context {
      let fits = measure(text(size: 12pt, weight: "bold", value)).width + 8pt <= w
      if fits { box(width: w, height: 0.55cm, fill: col, radius: 2pt, align(right + horizon, pad(right: 4pt, text(size: 12pt, fill: bg, weight: "bold", value)))) }
      else { stack(dir: ltr, spacing: 5pt, box(width: w, height: 0.55cm, fill: col, radius: 2pt), box(height: 0.55cm, align(horizon, text(size: 12pt, fill: white, weight: "bold", value)))) }
    })
  }).flatten())

// =====================================================================

#page(margin: 0pt, fill: bg)[
  #place(img("hero.png", width: 100%, height: 100%, fit: "cover"))
  #place(bottom + left, dx: 1.4cm, dy: -1.2cm, block(fill: rgb(11, 10, 28, 215), inset: 18pt, radius: 8pt)[
    #text(size: 38pt, weight: "bold", fill: accent)[A wizard, ray-marched]
    #v(-0.3em)
    #text(size: 20pt)[Pictures (and music) from pure functions, in Futhark, on the GPU]
    #v(-0.2em)
    #text(size: 15pt, fill: dim)[For programmers who have never done computer graphics]
  ])
]

#slide[What we built][
  #grid(columns: (1.6fr, 1fr), gutter: 1cm,
    img("cast.png", width: 100%),
    [
      A web page showing a wizard on a floating rock, flying over endless land, casting spells, with music.

      #v(0.3em)
      There are no 3D models, no image files and no audio files. Every pixel's colour, and every sound sample, is computed by a *pure function* from the time, the camera and a few settings.

      #v(0.3em)
      #note[It runs at 1920×1080, 60 times a second, in a browser.]
    ])
]

#section[The basics][How a computer draws a 3D picture]

#slide[The GPU: one function, millions of times][
  #grid(columns: (1fr, 1fr), gutter: 1.2cm,
    [
      #align(center, canvas(13, 8.4, {
        // a tiny picture, each cell coloured by the same function of (x, y):
        // a lit sphere
        let (nx, ny, s) = (16, 9, 0.8)
        for j in range(ny) { for i in range(nx) {
          let (x, y) = ((i + 0.5) / nx * 2 - 1, (j + 0.5) / ny * 2 - 1)
          let (u, v) = (x * 1.6, y)
          let r2 = u * u + v * v
          let col = if r2 < 0.7 {
            let z = calc.sqrt(0.7 - r2)
            let lit = calc.max(0.0, (-0.5 * u - 0.6 * v + 0.62 * z) / calc.sqrt(0.7))
            color.mix((accent, 30%), (fg, 70%)).darken((1 - lit) * 75%)
          } else { panel }
          at(i * s, j * s, rect(width: s * 0.94cm, height: s * 0.94cm, fill: col))
        } }
        label((0, 7.5), [each square: one pixel, one *thread*, the same code], col: dim, size: 13pt)
      }))
    ],
    [
      A screen is a grid of #term[pixels]: 2 million at 1080p, 60 frames a second, so 120 million colours a second.

      #v(0.3em)
      A #term[GPU] has thousands of simple cores built for this: they all run *the same function*, each on different input (here, each pixel's position).

      #v(0.3em)
      That function is called a #term[shader] or #term[kernel]. Ours is: _given a pixel, what colour is it?_
    ])
]

#slide[A camera made of rays][
  #grid(columns: (1.3fr, 1fr), gutter: 1cm,
    align(center, canvas(16, 8.5, {
      let eye = (0.8, 4.2)
      // the screen: a grid of pixels in front of the eye
      let (sx, top, n, ph) = (5.0, 1.5, 9, 0.6)
      for k in range(n) {
        let y = top + k * ph
        at(sx - 0.15, y, rect(width: 0.3cm, height: ph * 0.94cm, fill: if k == 3 { glow } else { panel }, stroke: 0.6pt + dim))
      }
      label((sx - 0.9, top + n * ph + 0.15), [screen (pixels)], col: dim, size: 13pt)
      let px = (sx, top + 3.5 * ph)
      let d = vnorm(vsub(px, eye))
      let c = (11.5, 3.0)
      let r = 1.6
      // where the ray through that pixel meets the sphere (solving |o + t d - c| = r)
      let oc = vsub(eye, c)
      let b = vdot(oc, d)
      let t = -b - calc.sqrt(b * b - (vdot(oc, oc) - r * r))
      let hit = vadd(eye, vmul(d, t))
      solid(c, r)
      for k in range(n) {
        let q = (sx, top + (k + 0.5) * ph)
        seg(eye, vadd(eye, vmul(vnorm(vsub(q, eye)), 16)), col: dim.transparentize(70%), w: 0.6pt)
      }
      arrow(eye, hit, col: glow, w: 2pt)
      dot(hit, col: warm, r: 5pt)
      dot(eye, col: fg)
      label((0.2, 4.6), [eye], col: dim)
      label((hit.at(0) - 1.4, hit.at(1) - 1.0), [hit], col: warm)
    })),
    [
      Put the eye at a point and the screen in front of it. For each pixel, shoot a #term[ray] (a half-line) from the eye through that pixel.

      #v(0.3em)
      Whatever the ray hits first is what that pixel shows. Its colour depends on *what* it hit and *how that spot is lit*.

      #v(0.3em)
      #note[So drawing a picture comes down to two questions per pixel: where does the ray hit, and how bright is it there?]
    ])
]

#slide[Two ways to find what a ray hits][
  #grid(columns: (1fr, 1fr), gutter: 1cm,
    [
      #align(center, canvas(13, 7.6, {
        seg((6, 0.6), (6, 7.0), col: dim, w: 2pt)
        label((5.1, 7.1), [screen], col: dim, size: 13pt)
        let tri = ((9.5, 1.6), (12.4, 3.6), (10.3, 6.4))
        place(polygon(fill: accent.transparentize(55%), stroke: 1.5pt + accent, ..tri.map(p => (p.at(0) * 1cm, p.at(1) * 1cm))))
        let eye = (1, 4)
        dot(eye, col: fg)
        let proj = tri.map(p => vadd(eye, vmul(vsub(p, eye), (6 - eye.at(0)) / (p.at(0) - eye.at(0)))))
        for (p, q) in tri.zip(proj) { seg(eye, p, col: accent.transparentize(40%), w: 1pt, dash: "dashed"); dot(q, col: accent, r: 2.5pt) }
        seg(proj.fold(proj.at(0), (a, b) => if b.at(1) < a.at(1) { b } else { a }), proj.fold(proj.at(0), (a, b) => if b.at(1) > a.at(1) { b } else { a }), col: glow, w: 4pt)
      }))
      #cap[*Rasterising* (games): shapes are made of triangles. Each triangle's corners are projected onto the screen and the pixels between them filled in.]
    ],
    [
      #align(center, canvas(13, 7.6, {
        seg((4, 0.6), (4, 7.0), col: dim, w: 2pt)
        label((3.1, 7.1), [screen], col: dim, size: 13pt)
        let c = (10.2, 4.0)
        solid(c, 1.8)
        let eye = (1, 4)
        dot(eye, col: fg)
        for y in (2.4, 3.2, 4.0, 4.8, 5.6) {
          let d = vnorm(vsub((4, y), eye))
          let pts = trace(circle-sd(c, 1.8), eye, d, max: 12)
          let last = pts.last().p
          seg(eye, last, col: glow.transparentize(40%), w: 1pt)
          for q in pts.slice(1) { dot(q.p, col: glow, r: 2pt) }
        }
      }))
      #cap[*Ray marching* (this project): shapes are *functions*. Each ray walks forward in steps, asking the scene "how far am I from the nearest surface?" until the answer is ≈ 0.]
    ])
]

#section[Shapes as functions][Distance functions and sphere tracing]

// the scene of field-shapes.png, in its own units (x in [-1.6, 1.6], y in
// [-0.9, 0.9], y up), and where a point of it lands on the image
#let field-scene(x, y) = {
  let c = calc.sqrt((x + 0.55) * (x + 0.55) + y * y) - 0.45
  let (qx, qy) = (calc.abs(x - 0.65) - 0.35, calc.abs(y) - 0.3)
  let b = calc.sqrt(calc.max(qx, 0) * calc.max(qx, 0) + calc.max(qy, 0) * calc.max(qy, 0)) + calc.min(calc.max(qx, qy), 0)
  calc.min(c, b)
}
#let field-w = 17.0
#let to-img(x, y) = ((x + 1.6) / 3.2 * field-w, (0.9 - y) / 1.8 * field-w * 9 / 16)
#let unit = field-w / 3.2 // cm per field unit

#slide[A shape is a distance function][
  #grid(columns: (17cm, 1fr), gutter: 0.8cm,
    [
      #box(width: field-w * 1cm, {
        img("field-shapes.png", width: field-w * 1cm)
        let (x, y) = (0.05, 0.55)
        let d = field-scene(x, y)
        let p = to-img(x, y)
        place(top + left, ring(p, d * unit, col: fg, w: 1.5pt, dash: "dashed"))
        place(top + left, dot(p, col: fg, r: 5pt))
        place(top + left, label(vadd(p, (0.25, -0.75)), [$p$], col: fg, size: 16pt))
      })
      #cap[Every point coloured by its distance: orange outside, blue inside, a band every 0.1 units, the surface in white. The dashed circle around $p$ has radius $d(p)$: it just touches the nearest surface.]
    ],
    [
      A #term[signed distance function] (SDF) $d(p)$ takes a point and returns how far it is from the nearest surface: positive outside, negative inside, 0 on it.
      ```
      -- a circle of radius r at the origin
      def circle p r = length p - r

      -- a scene: the nearer of two shapes
      def scene p =
        min (circle (p - c1) 0.45)
            (box (p - c2) size)
      ```
      Nothing else describes the shapes: no lists of points or triangles.
    ])
]

#slide[Sphere tracing][
  #grid(columns: (1.4fr, 1fr), gutter: 0.8cm,
    align(center, canvas(15, 8.5, {
      // the scene: a sphere and a wall; the trace is computed by the
      // algorithm on the right
      let sphere = circle-sd((6.0, 2.3), 1.6)
      let scene = p => calc.min(sphere(p), 13.6 - p.at(0))
      let o = (0.6, 5.4)
      let pts = trace(scene, o, vnorm(vsub((13.6, 2.9), o)))
      solid((6.0, 2.3), 1.6)
      place(dx: 13.6cm, rect(width: 2cm, height: 8.5cm, fill: accent.transparentize(72%), stroke: none))
      seg((13.6, 0), (13.6, 8.5), col: accent, w: 2pt)
      seg(o, pts.last().p, col: dim, w: 1pt, dash: "dotted")
      for (i, q) in pts.enumerate() {
        ring(q.p, q.d, col: glow.transparentize(45%), w: 1pt)
        dot(q.p)
      }
      label((0.1, 5.8), [camera], col: dim)
      label((4.9, 0.1), [sphere], col: accent)
      label((12.2, 7.6), [wall], col: accent)
      label((0.6, 7.9), [#pts.len() steps], col: glow, size: 13pt)
    })),
    [
      $d(p)$ is a *safe step*: nothing is closer than $d$, so the ray can jump that far without passing through anything (each circle touches the nearest surface, never crosses it).
      ```
      loop t = 0 while t < far do
        let d = scene (eye + t * dir)
        in if d < tiny then hit at t
           else t + d
      ```
      Big steps in open space; small ones while skimming past the sphere; big again; then it closes in on the wall.
    ])
]

#slide[Combining shapes is arithmetic][
  #grid(columns: (1fr, 1fr, 1fr), gutter: 0.6cm,
    fig("field-min.png", [`min a b`: both shapes (the nearer surface wins)], width: 100%),
    fig("field-smin.png", [`smin k a b`: both, blended with a fillet of size `k`], width: 100%),
    fig("field-subtract.png", [`max a (-b)`: `a` with `b` cut out], width: 100%))
  #v(0.4em)
  #grid(columns: (1.2fr, 1fr), gutter: 1cm,
    ```
    def smin k a b =   -- a "smooth minimum"
      let h = clamp 0 1 (0.5 + 0.5 * (b - a) / k)
      in mix b a h - k * h * (1 - h)
    ```,
    [The robe flows into the shoulders, the arms into the robe, the cradle's prongs into its collar: all `smin`. Each part also says what it is made of (a #term[material]), so the nearest part decides the colour.])
]

#slide[Move the point, not the shape][
  #grid(columns: (1fr, 1fr), gutter: 1cm,
    [
      #fig("field-repeat.png", [*Repetition*: before asking the circle, wrap the point into one cell (`p - cell * round (p / cell)`). Every cell then sees the same circle: infinitely many, for the price of one.], width: 100%)
    ],
    [
      #fig("field-bend.png", [*Bending*: before asking an ordinary straight capsule, rotate the point by an angle that grows with its height.], width: 100%)
      #note[The hat droops this way and the head turns this way. Bending stretches distances a little, so they are scaled down to stay safe steps.]
    ])
]

#section[Light][How bright is the spot a ray hits?]

#slide[Light and the surface's direction][
  #grid(columns: (1fr, 1fr), gutter: 1cm,
    [
      #align(center, canvas(13.5, 7.5, {
        // the same beam, straight down and slanted: the slanted one spreads
        // over a wider patch, so each bit of surface gets less of it
        let ground = 6.2
        seg((0, ground), (13.5, ground), col: dim, w: 2pt)
        let beam(x0, ang, col) = {
          let d = (calc.sin(ang), calc.cos(ang))
          let hit = k => (x0 + k * 0.6 / calc.cos(ang), ground)
          for k in range(3) { arrow(vsub(hit(k), vmul(d, 5)), hit(k), col: col, w: 1.2pt) }
          seg(hit(0), hit(2), col: col, w: 6pt)
        }
        beam(1.5, 0deg / 1rad, glow)
        beam(7.5, 60deg / 1rad, warm)
        arrow((11.0, ground), (11.0, ground - 2.6), col: fg, w: 1pt)
        label((11.2, ground - 2.8), [normal], col: dim, size: 13pt)
        label((0.6, ground + 0.3), [from overhead: bright], col: glow, size: 13pt)
        label((7.0, ground + 0.3), [slanted 60°: half as bright], col: warm, size: 13pt)
      }))
    ],
    [
      A surface's #term[normal] is the direction it faces (straight out of it).

      #v(0.3em)
      Light arriving at an angle $theta$ from the normal is spread over a wider patch, so each spot gets $cos theta$ as much: the basic lighting rule.

      #v(0.3em)
      The normal comes free from the distance function: it points the way $d$ grows fastest (its #term[gradient]), found by sampling $d$ at four points around the hit.
    ])
]

#slide[Normals straight from the distance function][
  #grid(columns: (17cm, 1fr), gutter: 0.8cm,
    [
      #box(width: field-w * 1cm, {
        img("field-shapes.png", width: field-w * 1cm)
        // arrows: the gradient of the field, by finite differences, at
        // points on the two surfaces
        let e = 0.002
        let surface-points = (
          ..range(0, 12).map(k => { let a = k / 12 * 2 * calc.pi; (-0.55 + 0.45 * calc.cos(a), 0.45 * calc.sin(a)) }),
          (0.65, 0.3), (0.65, -0.3), (1.0, 0.0), (0.3, 0.15), (1.0, 0.3), (0.85, 0.3))
        for (x, y) in surface-points {
          let g = (field-scene(x + e, y) - field-scene(x - e, y), field-scene(x, y + e) - field-scene(x, y - e))
          let n = vnorm(g)
          let a = to-img(x, y)
          let b = to-img(x + n.at(0) * 0.25, y + n.at(1) * 0.25)
          place(top + left, arrow(a, b, col: fg, w: 1.3pt))
        }
      })
      #cap[Arrows: the direction in which $d$ increases fastest, at points on the surfaces (computed here exactly as the renderer does).]
    ],
    [
      ```
      -- sample d a little either side of p
      normal p = normalise
        (d(p + e·x) - d(p - e·x),
         d(p + e·y) - d(p - e·y),
         d(p + e·z) - d(p - e·z))
      ```
      In 3D the renderer uses 4 samples on a tetrahedron rather than 6.

      #v(0.3em)
      At a box's corner the arrows fan out: the normal turns smoothly round it.
    ])
]

#slide[Shadows and dark corners, from the same function][
  #grid(columns: (1fr, 1fr), gutter: 1.2cm,
    [
      #align(center, canvas(13.5, 7.2, {
        let ground = 6.4
        seg((0, ground), (13.5, ground), col: dim, w: 2pt)
        let s = (1.2, ground)
        let l = vnorm((10.0, -5.6))
        // an occluder that the shadow ray just misses (by 0.35)
        let mid = vadd(s, vmul(l, 6.0))
        let side = (l.at(1), -l.at(0))
        let r = 1.1
        let c = vadd(mid, vmul(side, -(r + 0.35)))
        solid(c, r)
        let pts = trace(circle-sd(c, r), s, l, max: 7)
        // the penumbra estimate: the smallest k * d / t along the march
        let k = 6
        let best = pts.slice(1).fold(pts.at(1), (a, q) => if q.d / vlen(vsub(q.p, s)) < a.d / vlen(vsub(a.p, s)) { q } else { a })
        arrow(s, vadd(s, vmul(l, 12.5)), col: glow, w: 1.2pt)
        for q in pts.slice(1) { ring(q.p, q.d, col: glow.transparentize(60%), w: 0.8pt); dot(q.p, r: 2.5pt) }
        let toward = vnorm(vsub(c, best.p))
        seg(best.p, vadd(best.p, vmul(toward, best.d)), col: warm, w: 1.6pt)
        label(vadd(best.p, (-3.6, -0.6)), [smallest $d \/ t$], col: warm, size: 13pt)
        label((10.2, 0.2), [to the light], col: glow, size: 13pt)
        dot(s, col: fg)
        let shade = calc.min(1.0, k * best.d / vlen(vsub(best.p, s)))
        label((0.3, 6.6), [lit #calc.round(shade * 100) %], col: fg, size: 13pt)
      }))
      #cap[*Soft shadow*: march from the surface towards the light. If the ray hits something, the spot is in shadow; if it only passes close (small $d$ at distance $t$), it is partly shadowed. That gives soft shadow edges for free.]
    ],
    [
      #align(center, canvas(13.5, 7.2, {
        let floor = 6.4
        let wall = 6.0
        place(dx: 0cm, dy: floor * 1cm, rect(width: 13.5cm, height: 1cm, fill: panel, stroke: none))
        place(dx: wall * 1cm, dy: 0cm, rect(width: 8cm, height: 7.2cm, fill: panel, stroke: none))
        seg((0, floor), (wall, floor), col: dim, w: 2pt)
        seg((wall, floor), (wall, 0), col: dim, w: 2pt)
        let x = 4.6
        arrow((x, floor), (x, 1.2), col: fg, w: 1pt)
        label((2.7, 0.8), [normal], col: dim, size: 13pt)
        for h in (0.5, 1.2, 2.1, 3.2) {
          let q = (x, floor - h)
          let d = calc.min(h, wall - x)
          let crowded = d < h - 0.01
          ring(q, d, col: if crowded { warm } else { glow }.transparentize(40%), w: 1pt)
          dot(q, col: if crowded { warm } else { glow })
        }
        label((6.3, 2.0), [wall], col: dim, size: 13pt)
        label((0.2, 3.2), [blue: $d =$ distance\ stepped], col: glow, size: 12pt)
        label((0.2, 4.6), [orange: $d <$ distance\ stepped], col: warm, size: 12pt)
      }))
      #cap[*Ambient occlusion*: step a little way out along the normal, a few times. Where $d$ comes out smaller than the distance stepped, something else is close (the wall): the spot is in a corner, so less light from the sky reaches it.]
    ])
]

