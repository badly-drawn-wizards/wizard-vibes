#slide[Benchmarking honestly on a laptop][
  #let rows = read("data/warmup.jsonl").split("\n").filter(l => l.len() > 0).map(l => json(bytes(l)))
  #let n = rows.len()
  #grid(columns: (1.5fr, 1fr), gutter: 1cm,
    align(center, canvas(17, 9, {
      let (x0, x1, y0, y1) = (1.3, 16.6, 0.6, 7.6)
      let (lo, hi) = (21.0, 23.5)
      let px(i) = x0 + i / (n - 1) * (x1 - x0)
      let py(v) = y1 - (v - lo) / (hi - lo) * (y1 - y0)
      let pt(v) = y1 - (v - 50) / 40 * (y1 - y0)
      seg((x0, y1), (x1, y1), col: dim, w: 1pt)
      seg((x0, y0), (x0, y1), col: dim, w: 1pt)
      for v in (21.0, 22.0, 23.0) {
        label((0.0, py(v) - 0.3), [#v ms], col: dim, size: 11pt)
        seg((x0, py(v)), (x1, py(v)), col: dim.transparentize(75%), w: 0.6pt)
      }
      for (i, r) in rows.enumerate() {
        if r.at("tctl") != none { dot((px(i), pt(r.at("tctl"))), col: warm.transparentize(40%), r: 1.6pt) }
        if r.at("gpu") != none { dot((px(i), py(r.at("gpu"))), col: if r.at("build") == rows.at(0).at("build") { glow } else { accent }, r: 2.2pt) }
      }
      label((x0, 7.9), [samples in order (≈ 0.3 s each), from a cold start], col: dim, size: 12pt)
      label((x0 + 0.3, 0.0), [GPU ms per frame, two identical builds (blue, gold); CPU °C (orange, 50–90)], col: dim, size: 12pt)
    })),
    [
      An *A/A test*: two identical builds. From cold, frames drift ≈ 1 ms slower for a minute as the chip heats, then hold at its power limit. Fans at 100% changed nothing.
      #v(0.3em)
      So: *warm up*, interleave *A B B A*, report a mean difference with a 95% interval.
      #v(0.3em)
      #table(columns: (1fr, 1fr), stroke: 0.5pt + dim, inset: 6pt,
        [*to detect*], [*rounds*], [0.5 ms], [≈ 3], [0.25 ms], [≈ 9], [0.1 ms], [≈ 55])
    ])
]

#slide[Bugs found along the way][
  #grid(columns: (1fr, 1fr), gutter: 1cm,
    [
      - *false arriving as true*: the runtime copied a 1-byte bool into a 4-byte slot of uninitialised memory (patched: `malloc` → `calloc`)
      - *names containing 'z'* broke GPU calls (escaped at the call, not the definition; fixed upstream)
      - *`x ** 2` for negative `x`* is NaN in WGSL: one explosion ring turned the whole screen white
    ],
    [
      - *empty arrays* bound as too-small GPU buffers
      - *Asyncify's 4 KB stack* overflowing on a mid-frame read-back
      - *Chrome compiling pipelines on its GPU process's main thread*, freezing other canvases for seconds
      #v(0.4em)
      #note[Found by comparing CPU and GPU renders, and by bisecting with build variants.]
    ])
]

#slide[Takeaways][
  #grid(columns: (1.3fr, 1fr), gutter: 1cm,
    [
      - *One distance function* gives geometry, normals, shadows, occlusion and collisions
      - *Correct bounds* are the core of performance: every shortcut must never overestimate the distance
      - A *pure renderer* with state passed in is easy to test byte-for-byte
      - On the GPU, *code size and kernel count* matter as much as arithmetic
      - *Measure*: ablation, timestamps, A/A tests, confidence intervals
    ],
    fig("hero.png", [github.com/badly-drawn-wizards/wizard-vibes], width: 100%))
]
