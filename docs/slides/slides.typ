#section[Detail][Patterns, glass and glow without image files]

#slide[Noise: controlled randomness][
  #let hash(i) = { let v = calc.sin(i * 127.1 + 311.7) * 43758.5453; v - calc.floor(v) }
  #let vnoise(x) = { let i = calc.floor(x); let f = x - i; let u = f * f * (3 - 2 * f); hash(i) * (1 - u) + hash(i + 1) * u }
  #let fbm(x, n) = range(n).fold(0.0, (s, k) => s + calc.pow(0.5, k + 1) * vnoise(x * calc.pow(2, k) + k * 17.3))
  #let plot(f, y0, h, col, w: 1.6pt) = {
    let pts = range(0, 241).map(i => { let x = i / 240 * 8; (i / 240 * 15, y0 + h - f(x) * h) })
    poly(pts, col: col, w: w)
  }
  #grid(columns: (1.3fr, 1fr), gutter: 1cm,
    align(center, canvas(15, 9.5, {
      for i in range(0, 9) { let x = i / 8 * 15; dot((x, 2.3 - hash(i) * 2.0), col: dim, r: 2.5pt) }
      plot(vnoise, 0.3, 2.0, glow)
      label((0, 2.5), [*value noise*: a random value at each whole number, smoothly joined], col: glow, size: 13pt)
      for k in range(1, 4) { plot(x => 0.5 + calc.pow(0.5, k) * (vnoise(x * calc.pow(2, k) + k * 17.3) - 0.5) * 2, 3.3 + (k - 1) * 0.7, 0.9, dim, w: 0.9pt) }
      label((0, 5.6), [the same, twice as fine and half as strong, three more times ("#term[octaves]")], col: dim, size: 13pt)
      plot(x => fbm(x, 5), 6.4, 2.6, accent, w: 2pt)
      label((0, 9.0), [their sum (#term[fbm]): hills with bumps with pebbles], col: accent, size: 13pt)
    })),
    [
      A #term[hash] turns a number into a repeatable random-looking one. #term[Value noise] puts hashed values on a grid and blends smoothly between them.

      #v(0.3em)
      Adding octaves of noise gives natural detail at every scale. In 2D, that is the terrain's height; elsewhere, the bark, cloth, stone and clouds.

      #v(0.3em)
      #note[It is computed, so it never runs out and needs no memory: the land goes on for ever.]
    ])
]

#slide[Too much detail flickers][
  #grid(columns: (1.2fr, 1fr), gutter: 1cm,
    [
      #align(center, canvas(15, 5.4, {
        // a fine stripe pattern, sampled once per pixel: the samples trace
        // out a slow, false wave
        let f = 0.9 // cycles per pixel
        let sig = x => 2.6 - 1.8 * calc.sin(2 * calc.pi * f * x)
        let px = 1.0
        poly(range(0, 601).map(i => { let x = i / 600 * 14; (x + 0.5, sig(x / px)) }), col: dim.transparentize(40%), w: 0.8pt)
        let samples = range(0, 15).map(i => (i * px + 0.5, sig(i)))
        poly(range(0, 141).map(i => { let x = i / 10; (x + 0.5, 2.6 - 1.8 * calc.sin(2 * calc.pi * (f - 1) * x)) }), col: warm, w: 2pt)
        for s in samples { dot(s, col: glow, r: 3.5pt) }
        for i in range(0, 15) { seg((i * px + 0.5, 4.6), (i * px + 0.5, 4.9), col: dim, w: 1pt) }
        label((0.5, 5.0), [pixel centres], col: dim, size: 12pt)
        label((9.5, 4.6), [what the pixels show], col: warm, size: 13pt)
      }))
      #cap[A pattern finer than the pixels (grey), sampled at each pixel's centre (dots): the samples draw a slow wave that isn't there (orange). As the camera moves, it crawls and flickers. This is #term[aliasing].]
    ],
    [
      A pixel at distance $t$ covers a patch about $0.0008 t$ wide (at 1080p): its #term[footprint].

      #v(0.3em)
      So every pattern fades out its details finer than the footprint before it is sampled: the bricks' joints vanish in the distance, the cloth's weave close up appears, nothing shimmers.

      #v(0.3em)
      #fig("cottage.png", [], width: 100%)
    ])
]

#slide[Patterns on surfaces][
  #grid(columns: (1fr, 1.25fr), gutter: 0.8cm,
    fig("head.png", [hat stars, band, eyes, brows and beard locks: shapes, hashes and noise], width: 100%),
