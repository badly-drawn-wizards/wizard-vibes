#slide[Taking bigger steps, and backing off][
  // the same ray, marched with safe steps and with 1.4 times them
  #let ground = 6.6
  #let bump = circle-sd((11.6, 6.4), 0.8)
  #let scene = p => calc.min(ground - p.at(1), bump(p))
  #let o = (0.3, 4.6)
  #let d = vnorm((1.0, 0.13))
  #let safe = trace(scene, o, d, eps: 0.05)
  #let relaxed = trace(scene, o, d, eps: 0.05, relax: 1.4)
  #let draw(pts) = canvas(14.5, 7.4, {
    seg((0, ground), (14.5, ground), col: accent, w: 2pt)
    solid((11.6, 6.4), 0.8)
    seg(o, pts.last().p, col: dim, w: 0.8pt, dash: "dotted")
    for q in pts { if q.back { ring(q.p, q.d, col: bad, w: 1pt); dot(q.p, col: bad, r: 3.5pt) } else { ring(q.p, q.d, col: glow.transparentize(60%), w: 0.8pt); dot(q.p, r: 2.8pt) } }
  })
  #grid(columns: (1fr, 1fr), gutter: 0.8cm,
